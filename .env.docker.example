# Copy to .env in the repo root for `docker compose up --build`.
# Use REAL values from Supabase → Project Settings → API
# (same as apps/web/.env.local). Placeholders cause sign-in "Failed to fetch".
# Leave both blank to build a guest-only image (local scores only).

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
