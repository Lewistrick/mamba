# Copy to .env in the repo root for `docker compose up --build`.
# Values from Supabase → Project Settings → API.
# Placeholders / blanks for URL+anon → guest-only web image (no Account login).
# VITE_BASE_PATH=/mamba/ is set in docker-compose.yml.

# Shared project URL + anon key (Compose maps these into the web build as VITE_*).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only: insert verified multiplayer scores (Settings → API → service_role).
# Prefer this over anon for the game server.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Browser WebSocket URL (public wss via Caddy).
VITE_WS_URL=wss://lewistrick.com/mamba/ws
